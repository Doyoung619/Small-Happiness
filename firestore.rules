rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isGroupMember(groupId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    match /joys/{joyId} {
      allow read: if resource.data.visibility == "public"
        || (resource.data.visibility == "group" && isGroupMember(resource.data.groupId));
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "authorId", "author", "title", "description", "emoji", "imageUrl",
          "lat", "lng", "visibility", "groupId", "groupName", "createdAt", "sharedAt"
        ])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.author is string
        && request.resource.data.author.size() > 0
        && request.resource.data.author.size() <= 80
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 31
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 100
        && request.resource.data.emoji is string
        && request.resource.data.emoji.size() <= 8
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() <= 2048
        && request.resource.data.lat is number
        && request.resource.data.lat >= -90
        && request.resource.data.lat <= 90
        && request.resource.data.lng is number
        && request.resource.data.lng >= -180
        && request.resource.data.lng <= 180
        && (
          request.resource.data.visibility == "public"
          || (request.resource.data.visibility == "group"
            && request.resource.data.groupId is string
            && request.resource.data.groupName is string
            && request.resource.data.groupName.size() > 0
            && request.resource.data.groupName.size() <= 80
            && isGroupMember(request.resource.data.groupId))
        )
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn()
        && resource.data.authorId == request.auth.uid;
      allow update: if false;
    }

    match /groups/{groupId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(["name", "ownerId", "inviteCode", "memberIds", "memberNames", "createdAt"])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.size() == 6
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 1
        && request.resource.data.memberIds[0] == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["memberIds", "memberNames"])
        && request.auth.uid in request.resource.data.memberIds;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
